# ------------------------------------------------------------------------------
# Interactive shell guard
# ------------------------------------------------------------------------------

[[ -o interactive ]] || return

# ------------------------------------------------------------------------------
# History
# ------------------------------------------------------------------------------

HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt EXTENDED_HISTORY       # Save timestamp and duration of each command
setopt HIST_IGNORE_ALL_DUPS   # Drop older duplicates of a command
setopt HIST_IGNORE_SPACE      # Do not save commands starting with a space
setopt HIST_REDUCE_BLANKS     # Remove superfluous blanks before saving
setopt SHARE_HISTORY          # Share history across all open shells

# ------------------------------------------------------------------------------
# Colors: Nord Theme
# ------------------------------------------------------------------------------

if [[ -f "$HOME/.dir_colors" ]]; then
  eval "$(gdircolors -b "$HOME/.dir_colors")"
fi

# ------------------------------------------------------------------------------
# Auto Complete
# ------------------------------------------------------------------------------

fpath=(/opt/homebrew/share/zsh-completions $fpath)

autoload -Uz compinit
compinit

zmodload zsh/complist
zstyle ':completion:*' menu select                              # Navigate matches with arrow keys
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'       # Case-insensitive matching
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"         # Color matches like ls

# ------------------------------------------------------------------------------
# Up/down history search
# ------------------------------------------------------------------------------

autoload -Uz up-line-or-beginning-search
autoload -Uz down-line-or-beginning-search

zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

# Bind both the normal and the application mode sequences of the arrow keys
bindkey "^[[A" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search
[[ -n "${terminfo[kcuu1]}" ]] && bindkey "${terminfo[kcuu1]}" up-line-or-beginning-search
[[ -n "${terminfo[kcud1]}" ]] && bindkey "${terminfo[kcud1]}" down-line-or-beginning-search

# ------------------------------------------------------------------------------
# Zsh autosuggestions
# ------------------------------------------------------------------------------

ZSH_AUTOSUGGEST_STRATEGY=(match_prev_cmd)

if [[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# ------------------------------------------------------------------------------
# Aliases
# ------------------------------------------------------------------------------

alias cp="cp -iv"
alias icloud="cd ~/Library/Mobile\ Documents/com~apple~CloudDocs/"
alias ls="gls -lahF --group-directories-first --color=auto"
alias mkdir="mkdir -pv"
alias mv="mv -iv"
alias rm="rm -iv"
alias tailf="tail -f"
alias uuidgen="uuidgen | tr A-F a-f"
alias vim="nvim"

# ------------------------------------------------------------------------------
# Custom commands
# ------------------------------------------------------------------------------

search() {
  local pattern="$1"
  local folder="${2:-.}"

  if [[ -z "$pattern" ]]; then
    echo "usage: search <pattern> [folder]" >&2
    return 1
  fi

  rg --hidden --ignore-case "$pattern" "$folder"
}

download-media() {
  local url="$1"
  local dest="${2:-$HOME/Downloads}"

  if [[ -z "$url" ]]; then
    echo "usage: download-media <url> [dest-folder]" >&2
    return 1
  fi

  local name="${url##*/}"
  name="${name%%\?*}"
  [[ -z "$name" ]] && name="download-$(date +%s)"

  curl -fL --progress-bar -o "$dest/$name" "$url" && echo "saved to $dest/$name"
}

# ------------------------------------------------------------------------------
# Local configurations
# ------------------------------------------------------------------------------

[[ -f "$HOME/.zsh_private" ]] && source "$HOME/.zsh_private"

# ------------------------------------------------------------------------------
# Shell integrations
# ------------------------------------------------------------------------------

if command -v fzf >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git/*"'
  export FZF_CTRL_T_COMMAND="${FZF_DEFAULT_COMMAND}"

  _fzf_compgen_path() {
    rg --files --hidden --follow --glob "!.git/*"
  }

  source <(fzf --zsh)
fi

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if command -v starship >/dev/null 2>&1; then
  source <(starship init zsh --print-full-init)
fi
