# ------------------------------------------------------------------------------
# Interactive shell guard
# ------------------------------------------------------------------------------

[[ -o interactive ]] || return

# ------------------------------------------------------------------------------
# Auto Complete
# ------------------------------------------------------------------------------

fpath=(/opt/homebrew/share/zsh-completions $fpath)

zstyle ':compinstall' filename "$HOME/.zshrc"

autoload -Uz compinit
autoload -Uz colors
autoload -Uz up-line-or-beginning-search
autoload -Uz down-line-or-beginning-search

compinit
colors

# ------------------------------------------------------------------------------
# Up/down history search
# ------------------------------------------------------------------------------

zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

bindkey "^[[A" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search

# ------------------------------------------------------------------------------
# Colors: Nord Theme
# ------------------------------------------------------------------------------

if [[ -f "$HOME/.dir_colors" ]]; then
  eval "$(gdircolors -b "$HOME/.dir_colors")"
fi

# ------------------------------------------------------------------------------
# Git prompt
# ------------------------------------------------------------------------------

GIT_PS1_SHOWDIRTYSTATE="true"
GIT_PS1_SHOWSTASHSTATE="false"
GIT_PS1_SHOWUNTRACKEDFILES="true"
GIT_PS1_SHOWUPSTREAM="auto verbose name"

# ------------------------------------------------------------------------------
# Zsh autosuggestions
# ------------------------------------------------------------------------------

ZSH_AUTOSUGGEST_STRATEGY=(match_prev_cmd)

if [[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# ------------------------------------------------------------------------------
# Aliases
# ------------------------------------------------------------------------------

alias cp="cp -iv"
alias icloud="cd ~/Library/Mobile\ Documents/com~apple~CloudDocs/"
alias ls="gls -lahF --group-directories-first --color=auto"
alias mkdir="mkdir -pv"
alias mv="mv -iv"
alias rm="rm -iv"
alias tailf="tail -f"
alias uuidgen="uuidgen | tr A-F a-f"
alias vim="nvim"
alias cc="claude --dangerously-skip-permissions"

# ------------------------------------------------------------------------------
# Custom commands
# ------------------------------------------------------------------------------

search() {
  local pattern="$1"
  local folder="${2:-.}"

  if [[ -z "$pattern" ]]; then
    echo "usage: search <pattern> [folder]" >&2
    return 1
  fi

  rg --hidden --ignore-case "$pattern" "$folder"
}

# ------------------------------------------------------------------------------
# Local configurations
# ------------------------------------------------------------------------------

[[ -f "$HOME/.fzf.zsh" ]] && source "$HOME/.fzf.zsh"
[[ -f "$HOME/.zsh_private" ]] && source "$HOME/.zsh_private"

# ------------------------------------------------------------------------------
# Language/toolchain environments
# ------------------------------------------------------------------------------

[[ -f "$HOME/.rye/env" ]] && source "$HOME/.rye/env"
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
[[ -f "$HOME/.vite-plus/env" ]] && source "$HOME/.vite-plus/env"

# ------------------------------------------------------------------------------
# Shell integrations
# ------------------------------------------------------------------------------

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if command -v starship >/dev/null 2>&1; then
  source <(starship init zsh --print-full-init)
fi
