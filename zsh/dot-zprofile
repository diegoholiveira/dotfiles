# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------

export BLOCKSIZE="1k"
export CLICOLOR="true"
export GOPATH="$HOME/.go"
export GOBIN="$GOPATH/bin"
export HOMEBREW_NO_ENV_HINTS="true"
export HOMEBREW_BUNDLE_DUMP_NO_CARGO="true"
export HOMEBREW_BUNDLE_DUMP_NO_FLATPAK="true"
export HOMEBREW_BUNDLE_DUMP_NO_GO="true"
export HOMEBREW_BUNDLE_DUMP_NO_KREW="true"
export HOMEBREW_BUNDLE_DUMP_NO_MAS="true"
export HOMEBREW_BUNDLE_DUMP_NO_NPM="true"
export HOMEBREW_BUNDLE_DUMP_NO_UV="true"
export HOMEBREW_BUNDLE_DUMP_NO_VSCODE="true"
export HOMEBREW_BUNDLE_DUMP_NO_WINGET="true"
export JSII_SILENCE_WARNING_UNTESTED_NODE_VERSION="true"
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep/config"
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship/starship.toml"

# ------------------------------------------------------------------------------
# PATH
# ------------------------------------------------------------------------------

# removes duplicate entries while preserving order
typeset -U path

path=(
  /opt/homebrew/bin
  /opt/homebrew/sbin
  "$GOBIN"
  $path
  "$HOME/.docker/bin"
)

export PATH

# ------------------------------------------------------------------------------
# Language/toolchain environments
# ------------------------------------------------------------------------------

[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
[[ -f "$HOME/.vite-plus/env" ]] && source "$HOME/.vite-plus/env"
